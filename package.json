{
  "name": "movemeal",
  "private": true,
  "version": "0.1.0",
  "description": "MoveMeal – aplicație pentru personalizarea antrenamentelor și a alimentației",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=@movemeal/mobile",
    "api": "npm run start:dev --workspace=@movemeal/api",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "node scripts/dev.mjs"
  }
}
