{
  "expo": {
    "name": "MoveMeal",
    "slug": "movemeal",
    "scheme": "movemeal",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "md.movemeal.app"
    },
    "android": {
      "package": "md.movemeal.app",
      "adaptiveIcon": {
        "backgroundColor": "#E8F5EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "MoveMeal folosește camera pentru a fotografia masa și a estima caloriile.",
          "photosPermission": "MoveMeal accesează fotografiile pe care le alegi pentru a estima caloriile mesei.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
