# Copiaza acest fisier in .env si completeaza valorile.
POSTGRES_DB=movemeal
POSTGRES_USER=movemeal
POSTGRES_PASSWORD=
PORT=3000

# Parola rolului movemeal_app (aplicatia; respecta Row Level Security)
APP_DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Asistentul AI si recunoasterea alimentelor din fotografie (Google Gemini).
# Cheia se obtine gratuit din https://aistudio.google.com/apikey. Fara cheie, asistentul
# raspunde din regulile aplicatiei, iar fotografierea mesei nu este disponibila.
GEMINI_API_KEY=
# Optional: modelele folosite (implicit gemini-3.5-flash-lite si gemini-3.8-flash).
# GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# GEMINI_VISION_MODEL=gemini-3.8-flash
